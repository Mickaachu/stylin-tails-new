<% content_for :title, "Contact Stylin Tails" %>

<div class="mx-auto w-full max-w-6xl space-y-8 pb-20 pt-8">
  <section class="max-w-2xl"><p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">We are here to help</p><h1 class="mt-3 text-4xl font-black tracking-tight text-[#302735] md:text-5xl">Let's talk about your pet.</h1><p class="mt-4 text-base leading-7 text-[#6e6670]">Have a question about a service, your booking, or what your pet needs before their first visit? Send us a note and our team will get back to you.</p></section>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="rounded-3xl border border-[#eadfd5] bg-white p-6 shadow-sm md:p-8">
      <% if flash[:notice] %><div class="mb-5 rounded-xl border border-[#d6ead8] bg-[#edf9ee] px-4 py-3 text-sm font-semibold text-[#2f6e45]"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-600"><%= flash[:alert] %></div><% end %>
      <%= form_with url: contact_path, method: :post, class: "space-y-5" do |form| %>
        <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :name, "Your name", class: "mb-2 block text-sm font-bold text-[#302735]" %><%= form.text_field :name, value: @name, required: true, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-4 py-3 text-sm outline-none focus:border-[#6d4e97]" %></div><div><%= form.label :email, "Email address", class: "mb-2 block text-sm font-bold text-[#302735]" %><%= form.email_field :email, value: @email || current_user&.email, required: true, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-4 py-3 text-sm outline-none focus:border-[#6d4e97]" %></div></div>
        <div><%= form.label :message, "How can we help?", class: "mb-2 block text-sm font-bold text-[#302735]" %><%= form.text_area :message, value: @message, required: true, rows: 6, placeholder: "Tell us what you need...", class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-4 py-3 text-sm outline-none focus:border-[#6d4e97]" %></div>
        <%= form.submit "Send message", class: "rounded-full bg-[#6d4e97] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#563d75]" %>
      <% end %>
    </section>
    <aside class="space-y-4"><div class="rounded-3xl bg-[#6d4e97] p-6 text-white"><h2 class="text-xl font-black">Visit the salon</h2><p class="mt-3 text-sm leading-6 text-[#eadff9]">Harmony Springs<br>124 Willow Lane<br>Mon–Sat, 9:00 AM–5:00 PM</p></div><div class="rounded-3xl border border-[#eadfd5] bg-white p-6"><h2 class="text-xl font-black text-[#302735]">Quick answers</h2><p class="mt-3 text-sm leading-6 text-[#6e6670]">You can manage pets, appointments, and profile details from your member dashboard.</p><%= link_to "View services", services_path, class: "mt-4 inline-block text-sm font-bold text-[#6d4e97] hover:underline" %></div></aside>
  </div>
</div>
