<div class="mx-auto my-8 w-full max-w-md rounded-[28px] border border-[#e7ddd1] bg-[#f7f3ee] p-6 shadow-[0_24px_60px_rgba(76,68,82,0.12)] sm:my-12 sm:p-10">
  <div class="mb-8 text-center">
    <div class="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Welcome back</div>
    <h2 class="text-4xl font-black tracking-[-0.06em] text-[#201d22]">Log in</h2>
    <p class="mt-3 text-sm leading-6 text-[#5b5562]">Sign in to manage your pet's care.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-5">
      <%= f.label :email, class: "mb-2 block text-sm font-bold text-[#2d2a2f]" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-xl border border-[#d7cec6] bg-white px-4 py-3 text-[#201d22] shadow-sm outline-none transition placeholder:text-[#958b96] focus:border-[#6d4e97] focus:ring-2 focus:ring-[#6d4e97]/20" %>
    </div>

    <div class="mb-5">
      <%= f.label :password, class: "mb-2 block text-sm font-bold text-[#2d2a2f]" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "block w-full rounded-xl border border-[#d7cec6] bg-white px-4 py-3 text-[#201d22] shadow-sm outline-none transition placeholder:text-[#958b96] focus:border-[#6d4e97] focus:ring-2 focus:ring-[#6d4e97]/20" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-6 flex items-center gap-2 text-sm text-[#5b5562]">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-[#d7cec6] text-[#6d4e97] focus:ring-[#6d4e97]" %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Log in", class: "w-full cursor-pointer rounded-full bg-[#6d4e97] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#563d75] hover:shadow-lg hover:shadow-[#6d4e97]/20" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
