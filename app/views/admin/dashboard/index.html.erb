<% content_for :title, "Admin Command Center" %>

<div class="mx-auto w-full max-w-7xl space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><h1 class="text-3xl font-black tracking-tight text-[#302936]">Admin Command Center</h1><p class="mt-2 text-sm text-[#817884]">Monitor, coordinate, and review your grooming salon's operations for today.</p></div>
    <div class="flex items-center gap-2"><span class="rounded-lg border border-[#eadfd5] bg-white px-3 py-2 text-xs font-semibold text-[#4d4551]">&#128197; <%= Date.current.strftime("%b %-d, %Y") %></span><button type="button" onclick="window.location.reload()" class="rounded-lg border border-[#eadfd5] bg-white px-3 py-2 text-sm font-bold text-[#4d4551] transition hover:border-[#7650a7]">&#8635;</button></div>
  </header>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <%= link_to admin_appointments_path, class: "rounded-2xl border border-[#eadfd5] bg-white p-4 shadow-sm transition hover:-translate-y-0.5" do %><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Appointments today</p><div class="mt-2 flex items-end gap-3"><span class="text-3xl font-black text-[#7650a7]"><%= @today_appointments.size %></span><span class="mb-1 text-[10px] font-bold text-[#2c9b51]">+3 pending confirmation</span></div><% end %>
    <%= link_to admin_owners_path, class: "rounded-2xl border border-[#eadfd5] bg-white p-4 shadow-sm transition hover:-translate-y-0.5" do %><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Total customers</p><div class="mt-2 flex items-end gap-3"><span class="text-3xl font-black text-[#302936]"><%= @owners_count %></span><span class="mb-1 text-[10px] font-bold text-[#2c9b51]">Active owners</span></div><% end %>
    <div class="rounded-2xl border border-[#eadfd5] bg-white p-4 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Revenue this month</p><div class="mt-2 flex items-end gap-3"><span class="text-3xl font-black text-[#302936]"><%= number_to_currency(@monthly_revenue, precision: 0) %></span><span class="mb-1 text-[10px] font-bold text-[#7650a7]">Target: $18,000</span></div></div>
    <%= link_to admin_appointments_path, class: "rounded-2xl border border-[#eadfd5] bg-white p-4 shadow-sm transition hover:-translate-y-0.5" do %><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Pending bookings</p><div class="mt-2 flex items-end gap-3"><span class="text-3xl font-black text-[#ff9f7b]"><%= @pending_count %></span><span class="mb-1 text-[10px] font-bold text-[#d75b4c]">Needs action</span></div><% end %>
  </section>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <section class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between border-b border-[#f0e8e1] pb-4"><div><h2 class="text-lg font-black text-[#302936]">Today's schedule</h2><p class="mt-1 text-xs text-[#817884]">Appointments booked for the salon today.</p></div><%= link_to "View full calendar →", admin_appointments_path, class: "text-xs font-bold text-[#7650a7] hover:underline" %></div>
      <div class="mt-4 space-y-2">
        <% if @today_appointments.any? %><% @today_appointments.each do |appointment| %><%= link_to admin_appointment_path(appointment), class: "grid gap-2 rounded-xl border border-[#eadfd5] bg-[#fbf8f5] p-3 transition hover:border-[#7650a7] sm:grid-cols-[55px_1fr_auto] sm:items-center" do %><span class="text-xs font-black text-[#302936]"><%= appointment.date_time&.strftime("%I:%M %p") || "--" %></span><span><span class="block text-sm font-bold text-[#302936]"><%= appointment.pet&.name || "Pet unavailable" %> <span class="font-normal">(<%= appointment.pet&.breed || "Breed not set" %>)</span></span><span class="mt-1 block text-[10px] text-[#817884]">Owner: <%= appointment.owner&.full_name.presence || appointment.owner&.email || "Unavailable" %> · Service: <%= appointment.service.presence || "Grooming" %></span></span><span class="text-[10px] font-bold uppercase text-[#7650a7]"><%= appointment.owner&.full_name.to_s.split.first.presence || "Assigned" %></span><% end %><% end %><% else %><p class="py-10 text-center text-sm text-[#817884]">No appointments scheduled today.</p><% end %>
      </div>
    </section>

    <div class="space-y-6">
      <section class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><h2 class="text-lg font-black text-[#302936]">Recent customers</h2><%= link_to "View all", admin_owners_path, class: "text-xs font-bold text-[#7650a7] hover:underline" %></div><div class="mt-4 space-y-3"><% @recent_owners.each do |owner| %><%= link_to admin_owner_path(owner), class: "flex items-center justify-between gap-3 rounded-xl p-2 transition hover:bg-[#fbf8f5]" do %><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#efe6f8] text-[#7650a7]">♥</span><span class="min-w-0 flex-1"><span class="block truncate text-xs font-bold text-[#302936]"><%= owner.full_name.presence || "Unnamed owner" %></span><span class="block truncate text-[10px] text-[#817884]"><%= owner.email.presence || owner.user&.email || "No email" %></span></span><span class="text-[#302936]">›</span><% end %><% end %><% if @recent_owners.empty? %><p class="text-sm text-[#817884]">No customers yet.</p><% end %></div></section>
      <section class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm"><h2 class="text-lg font-black text-[#302936]">Recent booking activity</h2><div class="mt-4 space-y-4"><% @recent_activity.each do |appointment| %><div class="border-b border-[#f0e8e1] pb-3 last:border-0 last:pb-0"><div class="flex justify-between gap-3"><p class="text-xs font-bold text-[#7650a7]"><%= appointment.status.to_s == "completed" ? "Grooming completed" : "New appointment booked" %></p><span class="shrink-0 text-[10px] text-[#817884]"><%= time_ago_in_words(appointment.updated_at) %> ago</span></div><p class="mt-1 text-[10px] leading-4 text-[#817884]"><%= appointment.owner&.full_name.presence || appointment.owner&.email || "A customer" %> · <%= appointment.pet&.name || "Pet" %> · <%= appointment.service.presence || "Grooming service" %></p></div><% end %><% if @recent_activity.empty? %><p class="text-sm text-[#817884]">No booking activity yet.</p><% end %></div></section>
    </div>
  </div>
</div>
