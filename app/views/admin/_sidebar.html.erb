<aside class="flex w-full shrink-0 flex-col bg-[#302936] text-white lg:min-h-screen lg:w-64">
  <div class="flex items-center gap-3 border-b border-white/10 px-5 py-5 lg:px-6">
    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#ffb99c] text-sm font-black text-[#302936]">✿</span>
    <span class="text-sm font-black tracking-tight">Stylin Tails</span>
  </div>
  <nav class="flex gap-2 overflow-x-auto px-4 py-4 lg:block lg:space-y-2 lg:px-4 lg:py-8">
    <%= link_to admin_root_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-xs font-bold transition #{current_page?(admin_root_path) ? "bg-[#7650a7] text-white" : "text-[#d8d0dc] hover:bg-white/10"}" do %><span class="text-sm">▦</span> Dashboard<% end %>
    <%= link_to admin_appointments_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" do %><span class="text-sm">□</span> Appointments<% end %>
    <%= link_to admin_availabilities_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" do %><span class="text-sm">◷</span> Availability<% end %>
    <%= link_to admin_owners_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" do %><span class="text-sm">♧</span> Customers<% end %>
    <%= link_to admin_pets_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" do %><span class="text-sm">✦</span> Pets<% end %>
    <div class="hidden border-t border-white/10 pt-4 lg:block"><span class="block px-4 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#958a9e]">Management</span><%= link_to "Services & Rates", admin_root_path, class: "flex items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" %><%= link_to "Staff & Roster", admin_root_path, class: "flex items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold text-[#d8d0dc] transition hover:bg-white/10" %></div>
  </nav>
  <div class="mt-auto hidden border-t border-white/10 p-5 lg:block">
    <div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#efe6f8] text-[#6d4e97]">♥</span><div class="min-w-0"><p class="truncate text-xs font-bold"><%= current_user.email.split("@").first.titleize %></p><p class="text-[10px] text-[#b8adbf]">Lead Administrator</p></div></div>
    <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "mt-5 block text-xs font-semibold text-[#b8adbf] hover:text-white" %>
  </div>
</aside>
