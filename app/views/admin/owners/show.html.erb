<% content_for :title, "Owner Details" %>

<div class="mx-auto w-full max-w-5xl space-y-6 py-4"><%= link_to "Back to owners", admin_owners_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Owner profile</p><h1 class="mt-2 text-3xl font-black text-[#201d22]"><%= @owner.full_name.presence || "Unnamed owner" %></h1><p class="mt-2 text-[#6e6670]"><%= @owner.email.presence || @owner.user&.email || "No email" %> &middot; <%= @owner.phone.presence || "No phone" %></p></div><div class="flex gap-2"><%= link_to "Edit", edit_admin_owner_path(@owner), class: "rounded-full border border-[#eadfd5] px-4 py-2 text-sm font-bold text-[#6d4e97]" %><%= button_to "Delete", admin_owner_path(@owner), method: :delete, class: "rounded-full bg-[#fff1f3] px-4 py-2 text-sm font-bold text-[#b8455d]", data: { turbo_confirm: "Delete this customer and their pets?" } %></div></div></section><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><h2 class="text-xl font-black text-[#201d22]">Pets</h2><div class="mt-4 grid gap-3 sm:grid-cols-2"><% @owner.pets.each do |pet| %><%= link_to admin_pet_path(pet), class: "rounded-xl border border-[#eadfd5] bg-[#fbf8f5] p-4 hover:border-[#6d4e97]" do %><p class="font-bold text-[#201d22]"><%= pet.name.presence || "Unnamed pet" %></p><p class="text-sm text-[#6e6670]"><%= pet.breed.presence || "Breed not specified" %></p><% end %><% end %></div><% if @owner.pets.empty? %><p class="mt-4 text-sm text-[#6e6670]">No pets registered.</p><% end %></section><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><h2 class="text-xl font-black text-[#201d22]">Appointments</h2><div class="mt-4 space-y-3"><% @appointments.each do |appointment| %><%= link_to admin_appointment_path(appointment), class: "flex justify-between gap-4 rounded-xl border border-[#eadfd5] p-4 hover:border-[#6d4e97]" do %><span class="font-semibold text-[#201d22]"><%= appointment.pet&.name || "Pet unavailable" %> &middot; <%= appointment.service.presence || "Service not specified" %></span><span class="text-sm text-[#6e6670]"><%= appointment.date_time&.strftime("%b %-d, %Y") || "Date not set" %></span><% end %><% end %><% if @appointments.empty? %><p class="text-sm text-[#6e6670]">No appointments found.</p><% end %></div></section></div>
