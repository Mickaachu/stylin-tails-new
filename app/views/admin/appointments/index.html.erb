<% content_for :title, "Admin Appointments" %>

<div class="mx-auto w-full max-w-7xl space-y-6 py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Admin / Appointments</p><h1 class="mt-2 text-4xl font-black text-[#201d22]">Appointment schedule</h1></div><div class="flex items-center gap-4"><%= link_to "Dashboard", admin_root_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %><%= link_to "Add appointment", new_admin_appointment_path, class: "rounded-full bg-[#6d4e97] px-4 py-2.5 text-sm font-bold text-white" %></div></div>
  <div class="overflow-x-auto rounded-[22px] border border-[#eadfd5] bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="border-b border-[#eadfd5] bg-[#fbf8f5] text-xs uppercase tracking-[0.12em] text-[#6e6670]"><tr><th class="px-5 py-4">Date & time</th><th class="px-5 py-4">Pet</th><th class="px-5 py-4">Owner</th><th class="px-5 py-4">Service</th><th class="px-5 py-4">Status</th><th class="px-5 py-4">Action</th></tr></thead><tbody class="divide-y divide-[#f0e8e1]"><% @appointments.each do |appointment| %><tr class="hover:bg-[#fbf8f5]"><td class="px-5 py-4"><%= link_to appointment.date_time&.strftime("%b %-d, %Y at %-I:%M %p") || "Time not set", admin_appointment_path(appointment), class: "font-bold text-[#201d22] hover:text-[#6d4e97]" %></td><td class="px-5 py-4 text-[#6e6670]"><%= appointment.pet&.name || "Pet unavailable" %></td><td class="px-5 py-4 text-[#6e6670]"><%= appointment.owner&.full_name.presence || appointment.owner&.email || "Owner unavailable" %></td><td class="px-5 py-4 text-[#6e6670]"><%= appointment.service.presence || "Not specified" %></td><td class="px-5 py-4"><span class="rounded-full bg-[#f4eff9] px-3 py-1 text-xs font-bold capitalize text-[#6d4e97]"><%= appointment.status.presence || "pending" %></span></td><td class="px-5 py-4"><div class="flex gap-2"><% if ["pending", "requested"].include?(appointment.status.presence || "pending") %><%= button_to "Approve", approve_admin_appointment_path(appointment), method: :patch, class: "rounded-full bg-[#2c9b51] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#237d40]" %><%= button_to "Reject", reject_admin_appointment_path(appointment), method: :patch, class: "rounded-full bg-[#fff1f3] px-3 py-1.5 text-xs font-bold text-[#b8455d] hover:bg-[#ffe2e7]" %><% else %><%= link_to "View", admin_appointment_path(appointment), class: "text-xs font-bold text-[#6d4e97] hover:underline" %><% end %></div></td></tr><% end %></tbody></table><% if @appointments.empty? %><p class="p-10 text-center text-sm text-[#6e6670]">No appointments found.</p><% end %></div>
</div>
