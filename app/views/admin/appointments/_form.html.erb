<%= form_with model: appointment, url: appointment.persisted? ? admin_appointment_path(appointment) : admin_appointments_path, method: appointment.persisted? ? :patch : :post, class: "space-y-5" do |form| %>
  <% if appointment.errors.any? %><div class="rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-600"><%= appointment.errors.full_messages.to_sentence %></div><% end %>
  <div><%= form.label :owner_id, "Owner", class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.collection_select :owner_id, @owners, :id, :full_name, { prompt: "Select an owner" }, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div>
  <div><%= form.label :pet_id, "Pet", class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.collection_select :pet_id, @pets, :id, :name, { prompt: "Select a pet" }, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div>
  <div><%= form.label :service, class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.text_field :service, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div>
  <div><%= form.label :date_time, "Date and time", class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.datetime_local_field :date_time, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div>
  <div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :cost, class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.number_field :cost, step: 0.01, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div><div><%= form.label :status, class: "mb-2 block text-sm font-bold text-[#302936]" %><%= form.select :status, [["Pending", "pending"], ["Confirmed", "confirmed"], ["Completed", "completed"], ["Rejected", "rejected"]], {}, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-3 text-sm" %></div></div>
  <%= form.submit appointment.persisted? ? "Save appointment" : "Create appointment", class: "rounded-full bg-[#6d4e97] px-5 py-3 text-sm font-bold text-white" %>
<% end %>
