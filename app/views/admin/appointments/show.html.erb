<% content_for :title, "Appointment Details" %>

<div class="mx-auto w-full max-w-4xl space-y-6 py-4"><%= link_to "&larr; Back to appointments".html_safe, admin_appointments_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Appointment</p><h1 class="mt-2 text-3xl font-black text-[#201d22]"><%= @appointment.service.presence || "Grooming appointment" %></h1><dl class="mt-6 grid gap-5 sm:grid-cols-2"><div><dt class="text-xs font-bold uppercase tracking-[0.12em] text-[#6e6670]">Date & time</dt><dd class="mt-1 font-semibold text-[#201d22]"><%= @appointment.date_time&.strftime("%B %-d, %Y at %-I:%M %p") || "Not scheduled" %></dd></div><div><dt class="text-xs font-bold uppercase tracking-[0.12em] text-[#6e6670]">Status</dt><dd class="mt-1 font-semibold capitalize text-[#6d4e97]"><%= @appointment.status.presence || "pending" %></dd></div><div><dt class="text-xs font-bold uppercase tracking-[0.12em] text-[#6e6670]">Pet</dt><dd class="mt-1"><%= link_to @appointment.pet&.name || "Unavailable", admin_pet_path(@appointment.pet), class: "font-semibold text-[#6d4e97]" if @appointment.pet %></dd></div><div><dt class="text-xs font-bold uppercase tracking-[0.12em] text-[#6e6670]">Owner</dt><dd class="mt-1"><%= link_to @appointment.owner&.full_name.presence || @appointment.owner&.email || "Unavailable", admin_owner_path(@appointment.owner), class: "font-semibold text-[#6d4e97]" if @appointment.owner %></dd></div></dl><div class="mt-7 flex gap-3 border-t border-[#f0e8e1] pt-5"><% if ["pending", "requested"].include?(@appointment.status.presence || "pending") %><%= button_to "Approve appointment", approve_admin_appointment_path(@appointment), method: :patch, class: "rounded-full bg-[#2c9b51] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#237d40]" %><%= button_to "Reject", reject_admin_appointment_path(@appointment), method: :patch, class: "rounded-full bg-[#fff1f3] px-5 py-2.5 text-sm font-bold text-[#b8455d] hover:bg-[#ffe2e7]" %><% end %></div></section></div>
