<% content_for :title, "Manage Availability" %>

<div class="mx-auto w-full max-w-6xl space-y-6 py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Admin / Schedule</p><h1 class="mt-2 text-4xl font-black text-[#302936]">Manage availability</h1><p class="mt-2 text-sm text-[#817884]">Publish the dates and appointment intervals customers can book.</p></div><%= link_to "Dashboard", admin_root_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %></div>

  <div class="grid items-start gap-6 lg:grid-cols-[340px_minmax(0,1fr)]">
    <section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm">
      <h2 class="text-xl font-black text-[#302936]">Add available time</h2>
      <p class="mt-2 text-sm leading-5 text-[#817884]">Customers will see every interval between the start and end times.</p>
      <% if @availability.errors.any? %><div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-600"><%= @availability.errors.full_messages.to_sentence %></div><% end %>
      <%= form_with model: @availability, url: admin_availabilities_path, class: "mt-5 space-y-4" do |form| %>
        <div><%= form.label :available_on, "Available date", class: "mb-2 block text-xs font-bold uppercase tracking-widest text-[#6e6670]" %><%= form.date_field :available_on, required: true, min: Date.current, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-2.5 text-sm outline-none focus:border-[#6d4e97]" %></div>
        <div class="grid grid-cols-2 gap-3"><div><%= form.label :starts_at, "Opens", class: "mb-2 block text-xs font-bold uppercase tracking-widest text-[#6e6670]" %><%= form.time_field :starts_at, required: true, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-2.5 text-sm outline-none focus:border-[#6d4e97]" %></div><div><%= form.label :ends_at, "Closes", class: "mb-2 block text-xs font-bold uppercase tracking-widest text-[#6e6670]" %><%= form.time_field :ends_at, required: true, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-2.5 text-sm outline-none focus:border-[#6d4e97]" %></div></div>
        <div><%= form.label :interval_minutes, "Appointment interval", class: "mb-2 block text-xs font-bold uppercase tracking-widest text-[#6e6670]" %><%= form.select :interval_minutes, [["15 minutes", 15], ["30 minutes", 30], ["45 minutes", 45], ["60 minutes", 60]], {}, class: "w-full rounded-xl border border-[#eadfd5] bg-[#fbf8f5] px-3 py-2.5 text-sm outline-none focus:border-[#6d4e97]" %></div>
        <%= form.submit "Publish availability", class: "w-full cursor-pointer rounded-full bg-[#6d4e97] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#563d75]" %>
      <% end %>
    </section>

    <section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><div class="flex items-center justify-between"><div><h2 class="text-xl font-black text-[#302936]">Published schedule</h2><p class="mt-1 text-sm text-[#817884]">Upcoming dates currently visible to customers.</p></div><span class="rounded-full bg-[#e9f7ed] px-3 py-1 text-xs font-bold text-[#2c9b51]"><%= @availabilities.size %> windows</span></div><div class="mt-5 space-y-3"><% @availabilities.group_by(&:available_on).each do |date, windows| %><div class="rounded-xl border border-[#eadfd5] bg-[#fbf8f5] p-4"><div class="flex items-center justify-between gap-3"><p class="font-bold text-[#302936]"><%= date.strftime("%A, %B %-d, %Y") %></p><span class="text-xs font-semibold text-[#817884]"><%= windows.sum { |window| window.slots.size } %> slots</span></div><div class="mt-3 space-y-2"><% windows.each do |availability| %><div class="flex flex-col gap-2 rounded-lg bg-white px-3 py-2 text-sm sm:flex-row sm:items-center sm:justify-between"><span class="font-semibold text-[#6d4e97]"><%= availability.starts_at.strftime("%-I:%M %p") %> – <%= availability.ends_at.strftime("%-I:%M %p") %> <span class="font-normal text-[#817884]">(<%= availability.interval_minutes %> min intervals)</span></span><%= button_to "Remove", admin_availability_path(availability), method: :delete, class: "self-start text-xs font-bold text-[#b8455d] hover:underline sm:self-auto", data: { turbo_confirm: "Remove this availability window?" } %></div><% end %></div></div><% end %><% if @availabilities.empty? %><div class="rounded-xl border border-dashed border-[#d7cec6] p-10 text-center text-sm text-[#817884]">No availability published yet. Add a date and time window to open booking.</div><% end %></div></section>
  </div>
</div>
