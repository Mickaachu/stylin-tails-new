<% content_for :title, "Pet Details" %>

<div class="mx-auto w-full max-w-4xl space-y-6 py-4"><%= link_to "Back to pets", admin_pets_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Pet profile</p><h1 class="mt-2 text-3xl font-black text-[#201d22]"><%= @pet.name.presence || "Unnamed pet" %></h1><p class="mt-2 text-[#6e6670]"><%= @pet.breed.presence || "Breed not specified" %> &middot; <%= @pet.size.presence || "Size not specified" %></p></div><div class="flex gap-2"><%= link_to "Edit", edit_admin_pet_path(@pet), class: "rounded-full border border-[#eadfd5] px-4 py-2 text-sm font-bold text-[#6d4e97]" %><%= button_to "Delete", admin_pet_path(@pet), method: :delete, class: "rounded-full bg-[#fff1f3] px-4 py-2 text-sm font-bold text-[#b8455d]", data: { turbo_confirm: "Delete this pet?" } %></div></div><p class="mt-4 text-sm text-[#6e6670]">Owner: <%= link_to @pet.owner&.full_name.presence || @pet.owner&.email || "Unavailable", admin_owner_path(@pet.owner), class: "font-bold text-[#6d4e97]" if @pet.owner %></p></section><section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm"><h2 class="text-xl font-black text-[#201d22]">Appointment history</h2><div class="mt-4 space-y-3"><% @appointments.each do |appointment| %><%= link_to admin_appointment_path(appointment), class: "flex justify-between gap-4 rounded-xl border border-[#eadfd5] p-4 hover:border-[#6d4e97]" do %><span class="font-semibold text-[#201d22]"><%= appointment.service.presence || "Service not specified" %></span><span class="text-sm text-[#6e6670]"><%= appointment.date_time&.strftime("%b %-d, %Y") || "Date not set" %></span><% end %><% end %><% if @appointments.empty? %><p class="text-sm text-[#6e6670]">No appointments found.</p><% end %></div></section></div>
