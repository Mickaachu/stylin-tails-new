<% content_for :title, "Admin Pets" %>

<div class="mx-auto w-full max-w-7xl space-y-6 py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Admin / Pets</p><h1 class="mt-2 text-4xl font-black text-[#201d22]">Pet directory</h1></div><div class="flex items-center gap-4"><%= link_to "Dashboard", admin_root_path, class: "text-sm font-bold text-[#6d4e97] hover:underline" %><%= link_to "Add pet", new_admin_pet_path, class: "rounded-full bg-[#6d4e97] px-4 py-2.5 text-sm font-bold text-white" %></div></div>
  <div class="overflow-x-auto rounded-[22px] border border-[#eadfd5] bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="border-b border-[#eadfd5] bg-[#fbf8f5] text-xs uppercase tracking-[0.12em] text-[#6e6670]"><tr><th class="px-5 py-4">Pet</th><th class="px-5 py-4">Breed</th><th class="px-5 py-4">Size</th><th class="px-5 py-4">Owner</th></tr></thead><tbody class="divide-y divide-[#f0e8e1]"><% @pets.each do |pet| %><tr class="hover:bg-[#fbf8f5]"><td class="px-5 py-4"><%= link_to pet.name.presence || "Unnamed pet", admin_pet_path(pet), class: "font-bold text-[#201d22] hover:text-[#6d4e97]" %></td><td class="px-5 py-4 text-[#6e6670]"><%= pet.breed.presence || "Not specified" %></td><td class="px-5 py-4 text-[#6e6670]"><%= pet.size.presence || "Not specified" %></td><td class="px-5 py-4 font-semibold text-[#201d22]"><%= pet.owner&.full_name.presence || pet.owner&.email || "Owner unavailable" %></td></tr><% end %></tbody></table><% if @pets.empty? %><p class="p-10 text-center text-sm text-[#6e6670]">No pets found.</p><% end %></div>
</div>
