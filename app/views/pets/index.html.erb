<% content_for :title, "Pets" %>

<div class="mx-auto w-full max-w-6xl space-y-6 py-2">
  <% if notice.present? %>
    <p class="inline-block rounded-full border border-[#d6ead8] bg-[#edf9ee] px-4 py-2 text-sm font-medium text-[#2f6e45]" id="notice"><%= notice %></p>
  <% end %>

  <div class="overflow-hidden rounded-[30px] border border-[#eadfd5] bg-gradient-to-r from-[#f9f4f1] via-[#f6f0ea] to-[#f4edf8] p-5 shadow-[0_18px_40px_rgba(109,78,151,0.08)] sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Pet care</p>
        <h1 class="mt-2 font-bold text-4xl text-[#201d22] sm:text-5xl">Pets</h1>
      </div>
      <%= link_to "New pet", new_pet_path, class: "inline-flex items-center justify-center rounded-full bg-[#6d4e97] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-[#6d4e97]/20 transition duration-200 hover:-translate-y-0.5 hover:bg-[#563d75]" %>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-white/60 bg-white/70 p-3 backdrop-blur-sm">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Total</p>
        <p class="mt-2 text-2xl font-bold text-[#201d22]"><%= @pets.count %></p>
      </div>
      <div class="rounded-2xl border border-white/60 bg-white/70 p-3 backdrop-blur-sm">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Ready</p>
        <p class="mt-2 text-2xl font-bold text-[#201d22]">24/7</p>
      </div>
      <div class="rounded-2xl border border-white/60 bg-white/70 p-3 backdrop-blur-sm">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#6d4e97]">Status</p>
        <p class="mt-2 text-2xl font-bold text-[#201d22]">Active</p>
      </div>
    </div>
  </div>

  <div id="pets" class="space-y-4">
    <% if @pets.any? %>
      <% @pets.each do |pet| %>
        <div class="flex flex-col gap-5 rounded-[28px] border border-[#eadfd5] bg-[#fffdfb] p-5 shadow-[0_16px_28px_rgba(32,29,34,0.04)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_40px_rgba(109,78,151,0.12)] sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <%= render pet %>

          <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
            <%= link_to "Show", pet, class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
            <%= link_to "Edit", edit_pet_path(pet), class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
            <%= button_to "Destroy", pet, method: :delete, class: "inline-flex items-center justify-center rounded-full bg-[#b8455d] px-4 py-2.5 text-sm font-medium text-white transition duration-200 hover:bg-[#953d4d]", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-[28px] border border-dashed border-[#d7cfc7] bg-[#f9f4f1] p-10 text-center text-[#5b5562] shadow-inner">
        No pets found.
      </div>
    <% end %>
  </div>
</div>
