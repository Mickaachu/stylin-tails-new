<% content_for :title, "Editing pet" %>

<div class="mx-auto w-full max-w-4xl space-y-6">
  <div class="overflow-hidden rounded-[30px] border border-[#eadfd5] bg-gradient-to-r from-[#f9f4f1] via-[#f6f0ea] to-[#f4edf8] p-5 shadow-[0_18px_40px_rgba(109,78,151,0.08)] sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Pet profile</p>
        <h1 class="mt-2 text-4xl font-bold text-[#201d22]">Editing pet</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Show this pet", @pet, class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
        <%= link_to "Back to pets", pets_path, class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
      </div>
    </div>
  </div>

  <%= render "form", pet: @pet %>
</div>
