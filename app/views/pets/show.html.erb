<% content_for :title, "Showing pet" %>

<div class="mx-auto w-full max-w-4xl space-y-6">
  <% if notice.present? %>
    <p class="inline-block rounded-full border border-[#d6ead8] bg-[#edf9ee] px-4 py-2 text-sm font-medium text-[#2f6e45]" id="notice"><%= notice %></p>
  <% end %>

  <div class="overflow-hidden rounded-[30px] border border-[#eadfd5] bg-gradient-to-r from-[#f9f4f1] via-[#f6f0ea] to-[#f4edf8] p-5 shadow-[0_18px_40px_rgba(109,78,151,0.08)] sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Pet profile</p>
        <h1 class="mt-2 text-4xl font-bold text-[#201d22]">Showing pet</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Edit this pet", edit_pet_path(@pet), class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
        <%= link_to "Back to pets", pets_path, class: "inline-flex items-center justify-center rounded-full border border-[#d7cfc7] bg-white px-4 py-2.5 text-sm font-medium text-[#201d22] transition duration-200 hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
      </div>
    </div>
  </div>

  <div class="rounded-[28px] border border-[#eadfd5] bg-[#fffdfb] p-5 shadow-[0_16px_28px_rgba(32,29,34,0.04)] sm:p-6">
    <%= render @pet %>
  </div>

  <div class="flex justify-end">
    <%= button_to "Destroy this pet", @pet, method: :delete, class: "inline-flex items-center justify-center rounded-full bg-[#b8455d] px-5 py-3 text-sm font-medium text-white transition duration-200 hover:bg-[#953d4d]", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
