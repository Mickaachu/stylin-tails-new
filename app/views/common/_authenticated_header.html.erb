<header class="sticky top-0 z-50 border-b border-[#e8e0d9] bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 lg:px-8">
    <%= link_to dashboard_path, class: "shrink-0" do %>
      <%= image_tag "/logo.png", alt: "Stylin Tails", class: "h-10 w-auto" %>
    <% end %>
    <nav class="hidden items-center gap-7 text-sm font-medium text-[#4d4551] md:flex">
      <%= link_to "Home", root_path, class: "transition hover:text-[#6d4e97]" %>
      <%= link_to "My Dashboard", dashboard_path, class: "font-bold text-[#6d4e97]" %>
      <%= link_to "Grooming Services", services_path, class: "transition hover:text-[#6d4e97]" %>
      <%= link_to "Contact", contact_path, class: "transition hover:text-[#6d4e97]" %>
    </nav>
    <div class="flex items-center gap-4 text-sm">
      <% if current_user.admin? %>
        <%= link_to "Admin", admin_root_path, class: "hidden font-bold text-[#6d4e97] lg:inline" %>
      <% end %>
      <% profile_owner = current_user.owner %>
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-3 rounded-full px-2 py-1.5 transition hover:bg-[#fbf8f5] [&::-webkit-details-marker]:hidden">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#efe6f8] text-[#6d4e97]">&#9829;</span>
          <span class="hidden text-left sm:block"><span class="block max-w-37.5 truncate font-bold text-[#201d22]"><%= profile_owner&.full_name.presence || current_user.email.split("@").first %></span><span class="block text-[10px] text-[#6e6670]"><%= current_user.admin? ? "Administrator" : "Member" %></span></span>
          <span class="text-xs text-[#6e6670] transition group-open:rotate-180">&#9662;</span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-3 w-52 rounded-2xl border border-[#eadfd5] bg-white p-2 shadow-[0_18px_40px_rgba(32,29,34,0.12)]">
          <%= link_to "Profile", profile_path, class: "block rounded-xl px-3 py-2.5 text-sm font-semibold text-[#302735] transition hover:bg-[#f7f2fb] hover:text-[#6d4e97]" %>
          <% unless current_user.admin? %>
            <%= link_to "Settings", settings_path, class: "block rounded-xl px-3 py-2.5 text-sm font-semibold text-[#302735] transition hover:bg-[#f7f2fb] hover:text-[#6d4e97]" %>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to "Admin dashboard", admin_root_path, class: "block rounded-xl px-3 py-2.5 text-sm font-semibold text-[#302735] transition hover:bg-[#f7f2fb] hover:text-[#6d4e97]" %>
          <% end %>
          <div class="my-1 border-t border-[#f0e8e1]"></div>
          <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "block rounded-xl px-3 py-2.5 text-sm font-semibold text-[#b8455d] transition hover:bg-[#fff1f3]" %>
        </div>
      </details>
    </div>
  </div>
</header>
