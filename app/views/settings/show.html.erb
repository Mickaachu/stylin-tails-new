<% onboarding = params[:onboarding].present? %>
<% content_for :title, onboarding ? "Complete Your Profile" : "Account Settings" %>

<div class="mx-auto w-full max-w-2xl py-8 sm:py-14">
  <div class="rounded-[28px] border border-[#eadfd5] bg-white p-6 shadow-[0_24px_60px_rgba(76,68,82,0.10)] sm:p-10">
    <div class="mb-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-[#6d4e97]"><%= onboarding ? "One last step" : "Account settings" %></p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-[#302735]"><%= onboarding ? "Tell us about you" : "Your profile" %></h1>
      <p class="mt-3 text-sm leading-6 text-[#6e6670]"><%= onboarding ? "Add your contact details so we can keep your pet's appointments personal and easy to manage." : "Keep your name, phone number, and email up to date." %></p>
    </div>

    <% if @owner.errors.any? %>
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"><%= @owner.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= form_with scope: :settings, url: settings_path, method: :patch, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :full_name, "Full name", class: "mb-2 block text-sm font-bold text-[#302735]" %>
        <%= form.text_field :full_name, value: @owner.full_name, required: true, autofocus: true, autocomplete: "name", placeholder: "Elena Rostova", class: "block w-full rounded-xl border border-[#d7cec6] bg-[#fbf8f5] px-4 py-3 text-[#201d22] outline-none transition focus:border-[#6d4e97] focus:ring-2 focus:ring-[#6d4e97]/20" %>
      </div>

      <div>
        <%= form.label :phone, "Phone number", class: "mb-2 block text-sm font-bold text-[#302735]" %>
        <%= form.telephone_field :phone, value: @owner.phone, required: true, autocomplete: "tel", placeholder: "(555) 321-7654", class: "block w-full rounded-xl border border-[#d7cec6] bg-[#fbf8f5] px-4 py-3 text-[#201d22] outline-none transition focus:border-[#6d4e97] focus:ring-2 focus:ring-[#6d4e97]/20" %>
      </div>

      <div>
        <%= form.label :email, "Email address", class: "mb-2 block text-sm font-bold text-[#302735]" %>
        <%= form.email_field :email, value: current_user.email, required: true, autocomplete: "email", class: "block w-full rounded-xl border border-[#d7cec6] bg-[#fbf8f5] px-4 py-3 text-[#201d22] outline-none transition focus:border-[#6d4e97] focus:ring-2 focus:ring-[#6d4e97]/20" %>
      </div>

      <div class="flex flex-col-reverse gap-3 pt-3 sm:flex-row sm:justify-end">
        <% unless onboarding %><%= link_to "Cancel", dashboard_path, class: "rounded-full border border-[#eadfd5] px-5 py-3 text-center text-sm font-bold text-[#6e6670] transition hover:border-[#6d4e97]" %><% end %>
        <%= form.submit onboarding ? "Continue to dashboard" : "Save changes", class: "cursor-pointer rounded-full bg-[#6d4e97] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#563d75]" %>
      </div>
    <% end %>
  </div>
</div>
