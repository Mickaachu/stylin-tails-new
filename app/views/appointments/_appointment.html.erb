<div id="<%= dom_id appointment %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Service:</strong>
    <%= appointment.service %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Date time:</strong>
    <%= appointment.date_time %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pet:</strong>
    <%= appointment.pet_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Owner:</strong>
    <%= appointment.owner_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Cost:</strong>
    <%= appointment.cost %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= appointment.status %>
  </div>
</div>
