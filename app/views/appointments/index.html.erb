<% content_for :title, "My Appointments" %>

<div class="mx-auto w-full max-w-6xl space-y-8 pb-16 pt-6">
  <% if notice.present? %><div class="inline-flex rounded-full border border-[#d6ead8] bg-[#edf9ee] px-4 py-2 text-sm font-semibold text-[#2f6e45]" id="notice"><%= notice %></div><% end %>

  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div><span class="inline-flex rounded-full bg-[#f2edf8] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[#6d4e97]">Member portal</span><h1 class="mt-4 text-4xl font-black tracking-tight text-[#302735] md:text-5xl">My appointments</h1><p class="mt-3 text-sm leading-6 text-[#6e6670]">Keep track of upcoming visits and your pet's grooming history.</p></div>
    <%= link_to new_appointment_path, class: "rounded-full bg-[#6d4e97] px-5 py-3 text-center text-sm font-bold text-white shadow-lg shadow-[#6d4e97]/20 transition hover:bg-[#563d75]" do %><span class="mr-2">+</span> Book appointment<% end %>
  </header>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Total visits</p><p class="mt-2 text-3xl font-black text-[#302735]"><%= @appointments.size %></p></div>
    <div class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Upcoming</p><p class="mt-2 text-3xl font-black text-[#6d4e97]"><%= @appointments.count { |appointment| appointment.date_time.present? && appointment.date_time >= Time.current && appointment.status != "rejected" } %></p></div>
    <div class="rounded-2xl border border-[#eadfd5] bg-white p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Pets booked</p><p class="mt-2 text-3xl font-black text-[#302735]"><%= @appointments.map(&:pet_id).compact.uniq.size %></p></div>
  </section>

  <section class="rounded-3xl border border-[#eadfd5] bg-white p-5 shadow-sm md:p-7">
    <div class="mb-5 flex items-center justify-between border-b border-[#f0e8e1] pb-5"><div><h2 class="text-xl font-black text-[#302735]">Your appointments</h2><p class="mt-1 text-sm text-[#817884]">Select a visit to view details or make changes.</p></div><%= link_to "My dashboard", dashboard_path, class: "text-xs font-bold text-[#6d4e97] hover:underline" %></div>
    <div class="space-y-3">
      <% if @appointments.any? %>
        <% @appointments.order(date_time: :desc).each do |appointment| %>
          <% status = appointment.status.presence || "requested" %>
          <% status_classes = status == "confirmed" || status == "completed" ? "bg-[#e9f7ed] text-[#2c9b51]" : status == "rejected" ? "bg-[#fff1f3] text-[#b8455d]" : "bg-[#f4eff9] text-[#6d4e97]" %>
          <%= link_to appointment_path(appointment), class: "group grid gap-4 rounded-2xl border border-[#eadfd5] bg-[#fbf8f5] p-4 transition hover:-translate-y-0.5 hover:border-[#6d4e97] hover:bg-white hover:shadow-sm sm:grid-cols-[1fr_auto_auto] sm:items-center" do %>
            <div class="flex items-center gap-4"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#efe6f8] text-lg font-black text-[#6d4e97]"><%= appointment.pet&.name.to_s.first&.upcase || "P" %></span><span><span class="block font-bold text-[#302735]"><%= appointment.pet&.name.presence || "Pet unavailable" %></span><span class="mt-1 block text-xs text-[#6e6670]"><%= appointment.service.presence || "Grooming session" %></span></span></div>
            <div class="sm:text-right"><span class="block text-sm font-bold text-[#302735]"><%= appointment.date_time&.strftime("%b %-d, %Y") || "Date not set" %></span><span class="mt-1 block text-xs text-[#6e6670]"><%= appointment.date_time&.strftime("%-I:%M %p") || "Time not set" %></span></div>
            <div class="flex items-center justify-between gap-4 sm:block sm:text-right"><span class="rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-widest <%= status_classes %>"><%= status %></span><span class="ml-2 text-lg font-black text-[#6d4e97]"><%= appointment.cost ? number_to_currency(appointment.cost) : "-" %></span></div>
          <% end %>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-[#d7cec6] bg-[#fbf8f5] px-6 py-14 text-center"><p class="font-bold text-[#302735]">No appointments yet</p><p class="mt-2 text-sm text-[#6e6670]">Book your pet's first grooming visit to get started.</p><%= link_to "Book an appointment", new_appointment_path, class: "mt-5 inline-block rounded-full bg-[#6d4e97] px-5 py-3 text-sm font-bold text-white" %></div>
      <% end %>
    </div>
  </section>
</div>
*** End Patch
