<% content_for :title, "Appointment Details" %>

<div class="mx-auto w-full max-w-5xl space-y-6 pb-16 pt-6">
  <% if notice.present? %>
    <div class="inline-flex rounded-full border border-[#d6ead8] bg-[#edf9ee] px-4 py-2 text-sm font-semibold text-[#2f6e45]" id="notice"><%= notice %></div>
  <% end %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "Back to appointments", appointments_path, class: "text-sm font-bold text-[#6d4e97] transition hover:text-[#563d75]" %>
      <p class="mt-6 text-[11px] font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Member portal / Appointment</p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-[#302735] md:text-5xl">Your grooming visit</h1>
      <p class="mt-3 text-sm text-[#6e6670]">Everything you need for your pet's upcoming salon session.</p>
    </div>
    <span class="self-start rounded-full bg-[#e9f7ed] px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#2c9b51] sm:self-auto"><%= @appointment.status.presence || "Requested" %></span>
  </div>

  <section class="overflow-hidden rounded-[28px] border border-[#eadfd5] bg-white shadow-[0_18px_45px_rgba(109,78,151,0.08)]">
    <div class="bg-[#6d4e97] px-6 py-7 text-white md:px-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#eadff9]">Reserved service</p>
          <h2 class="mt-2 text-3xl font-black"><%= @appointment.service.presence || "Grooming session" %></h2>
          <p class="mt-2 text-sm text-[#eadff9]">For <%= @appointment.pet&.name.presence || "your pet" %></p>
        </div>
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-3xl">✂</div>
      </div>
    </div>

    <div class="grid gap-4 p-5 md:grid-cols-3 md:p-8">
      <div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Date</p><p class="mt-3 text-lg font-black text-[#302735]"><%= @appointment.date_time&.strftime("%b %-d, %Y") || "Not scheduled" %></p></div>
      <div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Time</p><p class="mt-3 text-lg font-black text-[#302735]"><%= @appointment.date_time&.strftime("%-I:%M %p") || "Not scheduled" %></p></div>
      <div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="text-[10px] font-bold uppercase tracking-widest text-[#817884]">Estimated cost</p><p class="mt-3 text-lg font-black text-[#6d4e97]"><%= @appointment.cost ? number_to_currency(@appointment.cost) : "To be confirmed" %></p></div>
    </div>
  </section>

  <div class="grid gap-6 md:grid-cols-2">
    <section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#f2edf8] text-[#6d4e97]">♥</span><div><h2 class="text-lg font-black text-[#302735]">Pet details</h2><p class="text-xs text-[#817884]">The pet joining us for this visit</p></div></div>
      <dl class="mt-6 space-y-4 text-sm"><div class="flex justify-between gap-4 border-b border-[#f0e8e1] pb-3"><dt class="text-[#817884]">Name</dt><dd class="font-bold text-[#302735]"><%= @appointment.pet&.name.presence || "Not specified" %></dd></div><div class="flex justify-between gap-4 border-b border-[#f0e8e1] pb-3"><dt class="text-[#817884]">Breed</dt><dd class="text-right font-semibold text-[#302735]"><%= @appointment.pet&.breed.presence || "Not specified" %></dd></div><div class="flex justify-between gap-4"><dt class="text-[#817884]">Size</dt><dd class="font-semibold text-[#302735]"><%= @appointment.pet&.size.presence || "Not specified" %></dd></div></dl>
    </section>

    <section class="rounded-[22px] border border-[#eadfd5] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#e8f6fb] text-[#319bc4]">i</span><div><h2 class="text-lg font-black text-[#302735]">What happens next</h2><p class="text-xs text-[#817884]">Your salon booking status</p></div></div>
      <p class="mt-6 text-sm leading-6 text-[#6e6670]"><% if @appointment.status == "confirmed" %>Your appointment is confirmed. We look forward to welcoming you and your pet.<% elsif @appointment.status == "rejected" %>This appointment request was not approved. Please choose another available time.<% else %>Your request has been received. Our team will review the time and confirm your appointment shortly.<% end %></p>
      <%= link_to "Book another appointment", new_appointment_path, class: "mt-5 inline-block text-sm font-bold text-[#6d4e97] hover:underline" %>
    </section>
  </div>

  <div class="flex flex-col gap-3 border-t border-[#eadfd5] pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Reschedule", edit_appointment_path(@appointment), class: "rounded-full border border-[#eadfd5] px-5 py-3 text-center text-sm font-bold text-[#6d6670] transition hover:border-[#6d4e97] hover:text-[#6d4e97]" %>
    <%= button_to "Cancel appointment", @appointment, method: :delete, class: "rounded-full bg-[#fff1f3] px-5 py-3 text-sm font-bold text-[#b8455d] transition hover:bg-[#ffe2e7]", data: { turbo_confirm: "Cancel this appointment?" } %>
  </div>
</div>
