<% content_for :title, "Grooming Services" %>

<div class="mx-auto w-full max-w-7xl space-y-12 pb-20 pt-8">
  <section class="rounded-[30px] bg-[#6d4e97] px-6 py-12 text-white shadow-xl shadow-[#6d4e97]/15 md:px-12 md:py-16">
    <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#eadff9]">Thoughtful care, tailored to your pet</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-black leading-tight tracking-tight md:text-6xl">Grooming that feels as good as it looks.</h1>
    <p class="mt-5 max-w-2xl text-base leading-7 text-[#f0e8fa] md:text-lg">Every session is built around calm handling, healthy skin and coat care, and a finish that makes your pet feel like themselves.</p>
    <%= link_to "Book an appointment", new_appointment_path, class: "mt-8 inline-block rounded-full bg-[#f4a97d] px-6 py-3 text-sm font-bold text-[#302735] transition hover:bg-[#ef9a68]" %>
  </section>

  <section>
    <div class="mb-8 max-w-2xl"><p class="text-xs font-bold uppercase tracking-[0.22em] text-[#6d4e97]">Our menu</p><h2 class="mt-3 text-3xl font-black tracking-tight text-[#302735] md:text-4xl">Choose the right reset.</h2><p class="mt-3 text-sm leading-6 text-[#6e6670]">Prices are starting estimates. Your groomer will confirm the final service after meeting your pet.</p></div>
    <div class="grid gap-5 md:grid-cols-3">
      <% descriptions = { "Full Grooming Session" => ["A complete refresh from bath to breed-specific finish.", "Massage bath, blowout, haircut, nails, and ears."], "Bath & Blowout" => ["A soothing clean-up for a fresh, comfortable coat.", "Warm bath, professional blowout, brushing, and ears."], "Nail Care & File" => ["A quick paw-care visit for smoother, healthier nails.", "Professional trim, filing, and comfort check."] } %>
      <% @services.each_with_index do |(service, price), index| %>
        <article class="flex flex-col rounded-3xl border border-[#eadfd5] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl <%= index == 1 ? "bg-[#e8f6fb] text-[#319bc4]" : "bg-[#f2edf8] text-[#6d4e97]" %> text-xl"><%= ["✂", "◌", "✦"][index] %></span>
          <h3 class="mt-6 text-2xl font-black text-[#302735]"><%= service %></h3>
          <p class="mt-3 text-sm font-semibold leading-6 text-[#6d4e97]"><%= descriptions[service][0] %></p>
          <p class="mt-3 flex-1 text-sm leading-6 text-[#6e6670]"><%= descriptions[service][1] %></p>
          <div class="mt-7 flex items-end justify-between border-t border-[#f0e8e1] pt-5"><span class="text-xs font-bold uppercase tracking-widest text-[#817884]">Starting at</span><span class="text-2xl font-black text-[#6d4e97]"><%= number_to_currency(price, precision: 0) %></span></div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="grid gap-5 md:grid-cols-3"><div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="font-black text-[#302735]">Gentle by default</p><p class="mt-2 text-sm leading-6 text-[#6e6670]">Quiet handling and patient transitions for nervous pets.</p></div><div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="font-black text-[#302735]">Personalized care</p><p class="mt-2 text-sm leading-6 text-[#6e6670]">Tell us what your pet needs when you book.</p></div><div class="rounded-2xl bg-[#fbf8f5] p-5"><p class="font-black text-[#302735]">Simple booking</p><p class="mt-2 text-sm leading-6 text-[#6e6670]">Choose from the dates and times our salon has published.</p></div></section>
</div>
