<div id="<%= dom_id owner %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Full name:</strong>
    <%= owner.full_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Phone:</strong>
    <%= owner.phone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= owner.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pet:</strong>
    <%= owner.pet_id %>
  </div>
</div>
